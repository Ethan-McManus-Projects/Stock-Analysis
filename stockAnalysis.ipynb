import joblib
import numpy as np
import tensorflow as tf
from tqdm import tqdm
from tensorflow.keras.models import Model
from tensorflow.keras.layers import Input, Dense, Dropout, Concatenate, LSTM
from sklearn.model_selection import train_test_split
import matplotlib.pyplot as plt

TIMESTEPS = 5  # Number of historical events to look back at


combined_data_2015 = joblib.load('combined_data_test.pkl.gz')

raw_eventcode = []
raw_actor1 = []
raw_actor2 = []
raw_singular = []
raw_labels = []

# Extract data in chronological order (do not group by label)
for data in tqdm(combined_data_2015, desc="Processing dataset"):
    label = data['label']
    
    for entry in data['data']:
        raw_eventcode.append(entry['EventCode'])
        raw_actor1.append(entry['Actor1Name'])
        raw_actor2.append(entry['Actor2Name'])
        
        singular_features = [
            entry['NumMentions'], entry['NumSources'],
            entry['Actor1Geo_Lat'], entry['Actor1Geo_Long'],
            entry['Actor2Geo_Lat'], entry['Actor2Geo_Long']
        ]
        raw_singular.append(singular_features)
        raw_labels.append(label)

# Convert to NumPy arrays for efficient slicing
raw_eventcode = np.array(raw_eventcode)
raw_actor1 = np.array(raw_actor1)
raw_actor2 = np.array(raw_actor2)
raw_singular = np.array(raw_singular)
raw_labels = np.array(raw_labels)

def create_sequences(data_array, timesteps):
    sequences = []
    # Slide a window of size 'timesteps' over the array
    for i in range(len(data_array) - timesteps + 1):
        sequences.append(data_array[i : i + timesteps])
    return np.array(sequences)

# Create 3D sequences: shape becomes (num_samples, timesteps, features)
seq_eventcode = create_sequences(raw_eventcode, TIMESTEPS)
seq_actor1 = create_sequences(raw_actor1, TIMESTEPS)
seq_actor2 = create_sequences(raw_actor2, TIMESTEPS)
seq_singular = create_sequences(raw_singular, TIMESTEPS)

# The label for a sequence is the label of the *last* event in that window
seq_labels = raw_labels[TIMESTEPS - 1:]

# Note: For strict time-series forecasting, shuffle=False is often used to prevent data leakage.
# Since your original code used random_state, we keep shuffle=True here assuming events are independent enough.
indices = np.arange(len(seq_labels))
train_idx, test_idx = train_test_split(indices, test_size=0.2, random_state=42)

X_train = {
    'input_eventcode': seq_eventcode[train_idx],
    'input_actor1': seq_actor1[train_idx],
    'input_actor2': seq_actor2[train_idx],
    'input_singular': seq_singular[train_idx]
}
y_train = seq_labels[train_idx]

X_test = {
    'input_eventcode': seq_eventcode[test_idx],
    'input_actor1': seq_actor1[test_idx],
    'input_actor2': seq_actor2[test_idx],
    'input_singular': seq_singular[test_idx]
}
y_test = seq_labels[test_idx]

input_eventcode = Input(shape=(TIMESTEPS, 512), name='input_eventcode')
input_actor1 = Input(shape=(TIMESTEPS, 300), name='input_actor1')
input_actor2 = Input(shape=(TIMESTEPS, 300), name='input_actor2')
input_singular = Input(shape=(TIMESTEPS, 6), name='input_singular')

x_eventcode = LSTM(64, activation='tanh')(input_eventcode)
x_actor1 = LSTM(64, activation='tanh')(input_actor1)
x_actor2 = LSTM(64, activation='tanh')(input_actor2)
x_singular = LSTM(32, activation='tanh')(input_singular)

concatenated = Concatenate()([x_eventcode, x_actor1, x_actor2, x_singular])

x = Dense(128, activation='relu')(concatenated)
x = Dropout(rate=0.5)(x)
output = Dense(1, activation='sigmoid')(x)

model = Model(inputs=[input_eventcode, input_actor1, input_actor2, input_singular], outputs=output)
model.compile(optimizer=tf.keras.optimizers.Adam(learning_rate=0.01), loss='binary_crossentropy', metrics=['accuracy'])
model.summary()

# Using standard Keras fit handles batching and shuffling correctly
history = model.fit(
    X_train, y_train,
    validation_data=(X_test, y_test),
    epochs=2,
    batch_size=32
)

epochs_range = range(1, 3)
plt.figure(figsize=(12, 4))

plt.subplot(1, 2, 1)
plt.plot(epochs_range, history.history['loss'], label='Training Loss')
plt.plot(epochs_range, history.history['val_loss'], label='Validation Loss')
plt.title('Training and Validation Loss')
plt.xlabel('Epochs')
plt.ylabel('Loss')
plt.legend()

plt.subplot(1, 2, 2)
plt.plot(epochs_range, history.history['accuracy'], label='Training Accuracy')
plt.plot(epochs_range, history.history['val_accuracy'], label='Validation Accuracy')
plt.title('Training and Validation Accuracy')
plt.xlabel('Epochs')
plt.ylabel('Accuracy')
plt.legend()

plt.tight_layout()
plt.show()
